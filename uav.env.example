# Persistent runtime/evidence data survives source upgrades.
UAV_DATA_DIR="$HOME/.local/share/remote-uav"
# Optional runtime overrides. Export these before ./uavctl start, or copy the
# values into your shell profile. Defaults are suitable for a local Ubuntu PC.
UAV_PORT=8370
UAV_SIM_BACKEND=gazebo
UAV_GAZEBO_GUI=auto
UAV_GAZEBO_SOFTWARE_RENDERING=1
# UAV_SIM_IMAGE=px4io/px4-sitl-gazebo:v1.18.0-beta1-660-g61907962c9
