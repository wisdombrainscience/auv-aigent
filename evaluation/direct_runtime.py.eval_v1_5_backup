async def wait_flight_ready(
    timeout_s: float = 60.0,
    poll_s: float = 0.25,
    stable_s: float = 2.0,
    adapter_factory: Any = PX4SITLAdapter,
) -> dict[str, Any]:
    """Wait for a fresh PX4/Gazebo instance to be *arming-ready*.

    ``/api/session/reset`` reports that the managed simulator container is running,
    but PX4 can still be inside its estimator/home-position readiness window.  The
    earlier evaluation harness only waited for local position.  Real smoke evidence
    then showed repeated ``COMMAND_DENIED`` from ``arm()`` even though local position
    was already valid.

    For evaluation we therefore establish a stronger pre-measurement readiness gate:
    connection + local position + PX4's explicit ``is_armable`` health flag when
    available.  Older MAVSDK Health objects do not expose ``is_armable``; in that
    case global-position and home-position health are used when those fields exist.
    The condition must remain true for ``stable_s`` before the campaign proceeds.
    This does not arm or command the vehicle and is therefore outside capability
    execution/evidence.
    """
    if timeout_s <= 0:
        raise ValueError("timeout_s must be > 0")
    if poll_s <= 0:
        raise ValueError("poll_s must be > 0")
    if stable_s < 0:
        raise ValueError("stable_s must be >= 0")

    adapter = adapter_factory()
    last: dict[str, Any] = {}
    stable_since: float | None = None
    loop = asyncio.get_running_loop()
    try:
        await adapter.connect()
        deadline = loop.time() + float(timeout_s)
        while loop.time() < deadline:
            try:
                state = await adapter.get_state()
                health = await adapter._cached_telemetry("health")
                local_ok = bool(getattr(health, "is_local_position_ok", state.localization_valid))
                armable_attr = getattr(health, "is_armable", None)
                global_attr = getattr(health, "is_global_position_ok", None)
                home_attr = getattr(health, "is_home_position_ok", None)

                # Prefer PX4/MAVSDK's direct armability health bit when present.
                # On older bindings, global/home readiness is the closest explicit
                # proxy for the checks that commonly lag local-position readiness.
                if armable_attr is not None:
                    arming_health_ok = bool(armable_attr)
                    readiness_source = "is_armable"
                else:
                    optional = [v for v in (global_attr, home_attr) if v is not None]
                    arming_health_ok = all(bool(v) for v in optional) if optional else True
                    readiness_source = "global_home_fallback"

                ready = bool(state.connected and local_ok and arming_health_ok)
                last = {
                    "connected": bool(state.connected),
                    "localization_valid": bool(state.localization_valid),
                    "health_local_position_ok": local_ok,
                    "health_global_position_ok": None if global_attr is None else bool(global_attr),
                    "health_home_position_ok": None if home_attr is None else bool(home_attr),
                    "health_is_armable": None if armable_attr is None else bool(armable_attr),
                    "readiness_source": readiness_source,
                    "ready": ready,
                }

                if ready:
                    if stable_since is None:
                        stable_since = loop.time()
                    if loop.time() - stable_since >= float(stable_s):
                        pos = await adapter.get_position()
                        last["position_m"] = [pos.x, pos.y, pos.z]
                        last["stable_s"] = round(loop.time() - stable_since, 3)
                        return last
                else:
                    stable_since = None
            except (TimeoutError, RuntimeError) as exc:
                stable_since = None
                last = {"transient_error": f"{type(exc).__name__}: {exc}"}
            await asyncio.sleep(poll_s)
        raise TimeoutError(f"flight readiness not reached before {timeout_s:g}s: {last}")
    finally:
        await adapter.close()


async def wait_localization_ready(timeout_s: float = 30.0, poll_s: float = 0.25) -> dict[str, Any]:
    """Backward-compatible alias using the stronger flight-readiness gate."""
    return await wait_flight_ready(timeout_s=timeout_s, poll_s=poll_s, stable_s=0.0)


class TelemetryDropoutAdapter:
    """Evaluation-only proxy.

    Flight-control methods are delegated unchanged to the real PX4SITLAdapter.
    Only evidence-facing get_telemetry_sample() is altered, so this probes whether
    the independent verifier fails closed when measured telemetry loses validity.
    """

    def __init__(self, inner: PX4SITLAdapter, *, start_after: int = 4, length: int = 12) -> None:
        self.inner = inner
        self.start_after = int(start_after)
        self.length = int(length)
        self.sample_count = 0

    def __getattr__(self, name: str) -> Any:
        return getattr(self.inner, name)

    async def connect(self) -> None:
        await self.inner.connect()

    async def close(self) -> None:
        await self.inner.close()

    async def get_telemetry_sample(self) -> Any:
        sample = await self.inner.get_telemetry_sample()
        self.sample_count += 1
        lo = self.start_after + 1
        hi = self.start_after + self.length
        if lo <= self.sample_count <= hi:
            return replace(sample, localization_valid=False)
        return sample


async def run_fresh_nav_trial(
    *,
    scenario: str,
    target: list[float],
    nav_timeout_s: float = 30.0,
    telemetry_dropout: bool = False,
) -> dict[str, Any]:
    simulator = SimulationSupervisor(PROJECT)
    simulator.start_new([0.0, 0.0, -0.0])
    await wait_localization_ready()
    runner = CapabilityExperimentRunner(PROJECT)
    base = PX4SITLAdapter()
    takeoff = None
    nav = None
    cleanup_error = None
    try:
        takeoff = await runner.run(
            "TAKEOFF-001",
            input_data=dict(TAKEOFF_INPUT),
            scenario_id=f"{scenario}__TAKEOFF",
            adapter=base,
            post_action="hold",
            close_adapter=False,
        )
        nav_adapter: Any = TelemetryDropoutAdapter(base) if telemetry_dropout else base
        nav = await runner.run(
            "NAV-001",
            input_data=nav_input(target, nav_timeout_s),
            scenario_id=f"{scenario}__NAV",
            adapter=nav_adapter,
            post_action="hold",
            close_adapter=False,
        )
    finally:
        try:
            await base.close()
        except Exception as exc:
            cleanup_error = f"{type(exc).__name__}: {exc}"
        simulator.stop()
    return {
        "takeoff": takeoff,
        "nav": nav,
        "cleanup_error": cleanup_error,
    }
