def nav_input(target: list[float], timeout_s: float = 30.0) -> dict[str, Any]:
    return {
        "task_id": "NAV-001",
        "frame": "LOCAL_NED",
        "target_position_m": [float(v) for v in target],
        "position_tolerance_m": 0.5,
        "timeout_s": float(timeout_s),
